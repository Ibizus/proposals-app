# ==============================================================================
# ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to '.env' and fill in your local values.
# DO NOT COMMIT '.env' TO GIT!
# ==============================================================================

# Database Configuration (MySQL)
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/proposals_db?createDatabaseIfNotExist=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=db_password

# Mail Configuration (Gmail SMTP or Resend)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=email@domain.com
SPRING_MAIL_PASSWORD=email_password

# Application Storage & Path Settings
APP_ATTACH_PATH=uploads/