# ==============================================================================
# ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to '.env' and fill in your local values.
# DO NOT COMMIT '.env' TO GIT!
# ==============================================================================

# Database Configuration (MySQL)
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/proposals_db?createDatabaseIfNotExist=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=db_password

# Mail Configuration
# Without a .env the backend already works out of the box: it sends into Mailpit
# (localhost:1025), the zero-secret SMTP server that docker-compose.yml / ./dev.sh
# start, and the web UI is at http://localhost:8025. To send real mail through
# Resend instead, uncomment and fill the variables below. Real API keys belong only
# in this gitignored .env file or in deployment environment variables.
#SPRING_MAIL_HOST=smtp.resend.com
#SPRING_MAIL_PORT=587
#SPRING_MAIL_USERNAME=resend
#SPRING_MAIL_PASSWORD=re_xxxxxxxxxxxx
#SPRING_MAIL_SMTP_AUTH=true

# Application Storage & Path Settings
APP_ATTACH_PATH=uploads/